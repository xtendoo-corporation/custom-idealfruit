<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
           <record id="view_purchase_supplier_form_inherit_no_create" model="ir.ui.view">
            <field name="name">purchase.supplier.form.inherit.no.create</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="purchase.view_product_supplier_inherit"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='seller_ids']" position="replace">
                    <field name="not_create_group" invisible="1"/>
                    <field name="seller_ids" context="{'default_product_tmpl_id':context.get('product_tmpl_id',active_id), 'product_template_invisible_variant': True, 'tree_view_ref':'purchase.product_supplierinfo_tree_view2'}" nolabel="1" attrs="{'invisible': [('product_variant_count','&gt;',1)], 'readonly': ['|',('product_variant_count','&gt;',1), ('not_create_group', '=', True)]}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
