<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
           <record id="view_purchase_order_form_inherit_no_create" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit.no.create</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="before">
                    <field name="not_create_group" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="options">{'no_create': True, 'no_quick_create': True}</attribute>
                </xpath>
                <xpath expr="//page[@name='products']/field[@name='order_line']//field[@name='product_id']" position="attributes">
                    <attribute name="options">{'no_create': True, 'no_quick_create': True}</attribute>
                </xpath>

            </field>
        </record>
    </data>
</odoo>

