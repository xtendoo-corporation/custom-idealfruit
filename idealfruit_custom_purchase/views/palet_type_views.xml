<odoo>

    <record id="action_palet_type" model="ir.actions.act_window">
        <field name="name">Tipos de Palets</field>
        <field name="res_model">palet.type</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_palet_type_root"  name="Palets" parent="purchase.menu_purchase_config" sequence="10"/>

    <menuitem id="menu_palet_type"  name="Tipos de palets" parent="menu_palet_type_root" action="action_palet_type"/>

    <record id="view_palet_type_tree" model="ir.ui.view">
        <field name="name">palet.type.tree</field>
        <field name="model">palet.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="description"/>
                <field name="palet_category_id"/>
                <field name="length"/>
                <field name="width"/>
                <field name="height"/>
                <field name="udm"/>
                <field name="weight"/>
                <field name="weight_udm"/>
            </tree>
        </field>
    </record>

    <record id="view_palet_type_form" model="ir.ui.view">
        <field name="name">palet.type.form</field>
        <field name="model">palet.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="palet_category_id"/>
                        <field name="length"/>
                        <field name="width"/>
                        <field name="height"/>
                        <field name="udm"/>
                        <field name="weight"/>
                        <field name="weight_udm"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
