<odoo>

    <record id="action_palet_category" model="ir.actions.act_window">
        <field name="name">Categorias de Palets</field>
        <field name="res_model">palet.category</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_palet_category"  name="Categorias de Palets" parent="menu_palet_type_root" action="action_palet_category"/>

    <record id="view_palet_category_tree" model="ir.ui.view">
        <field name="name">palet.category.tree</field>
        <field name="model">palet.category</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="description"/>
                <field name="length"/>
                <field name="width"/>
                <field name="height"/>
                <field name="udm"/>
            </tree>
        </field>
    </record>

    <record id="view_palet_category_form" model="ir.ui.view">
        <field name="name">palet.category.form</field>
        <field name="model">palet.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="length"/>
                        <field name="width"/>
                        <field name="height"/>
                        <field name="udm"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
