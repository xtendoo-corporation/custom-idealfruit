<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document">
        <t t-call="idealfruit_custom_purchase.external_layout_cmr">
            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
            <t t-set="address">
                </t>
            <t t-if="user_to_sell">
                <t t-set="information_block">
                </t>
            </t>
            <div class="page">
                <div class="oe_structure"/>
                <div id="informations" class="row mt-4 mb32">
                    <div class="col-3 bm-2">
                        <strong>Nº Albarán</strong>
                        <p t-field="o.name" class="m-0"/>
                    </div>
                    <div t-if="o.state in ['purchase','done'] and o.date_approve" class="col-3 bm-2">
                        <strong>Fecha:</strong>
                        <p t-field="o.date_approve" class="m-0" t-options='{"widget": "datetime", "format": "dd/MM/YYYY"}'/>
                    </div>
                    <div t-elif="o.date_order" class="col-3 bm-2">
                        <strong >Fecha:</strong>
                        <p t-field="o.date_order" class="m-0" t-options='{"widget": "datetime", "format": "dd/MM/YYYY"}'/>
                    </div>
                </div>

                <table class="table table-sm o_main_table table-borderless mt-4">
                    <thead style="display: table-row-group">
                        <tr>
                            <th name="th_description"><strong>Descripción</strong></th>
                            <th name="th_taxes"><strong>Uni./C</strong></th>
                            <th name="th_date_req" class="text-center"><strong>Referencia</strong></th>
                            <th name="th_quantity" class="text-end"><strong>Lote</strong></th>
                            <th name="th_price_unit" class="text-end"><strong>Cajas</strong></th>
<!--                            <th name="th_amount" class="text-end"><strong>Unidades</strong></th>-->
                            <th name="th_amount" class="text-end"><strong>Kilos</strong></th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="current_subtotal" t-value="0"/>
                        <t t-foreach="o.order_line" t-as="line">
                            <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                <t t-if="not line.display_type">
                                    <td id="product">
                                        <span t-field="line.product_id.name"/>
                                    </td>
                                    <td id="unit_box" class="text-end">
                                        <span t-field="line.unit_box"/>
                                    </td>
                                    <td id="reference">
                                        <span>Referencia</span>
                                    </td>
                                    <td id="lote">
                                        <span>Lote</span>
                                    </td>
                                    <td id="box" class="text-end">
                                        <span t-field="line.box"/>
                                    </td>
                                    <td id="weight" class="text-end">
                                        <span t-field="line.product_qty"/>
                                    </td>

                                </t>
                                <t t-if="line.display_type == 'line_section'">
                                    <td colspan="99" id="section">
                                        <span t-field="line.name"/>
                                    </td>
                                    <t t-set="current_section" t-value="line"/>
                                    <t t-set="current_subtotal" t-value="0"/>
                                </t>
                                <t t-if="line.display_type == 'line_note'">
                                    <td colspan="99" id="note">
                                        <span t-field="line.name"/>
                                    </td>
                                </t>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div id="total" class="row justify-content-end">
                    <div class="col-4">
                        <table class="table table-sm table-borderless">
                            <t t-set="tax_totals" t-value="o.tax_totals"/>
                            <t t-call="account.document_tax_totals"/>
                        </table>
                    </div>
                </div>

<!--                <p t-field="o.notes" class="mt-4"/>-->
                <div class="row">
                    <p>RECIBÍ Y CONFORME CON LA MERCANCÍA</p>
                </div>
                <div class="row">
                    <div class="col-4">
                        <p class="m-0"><strong>Ideal Fruits, S.L.</strong></p>
                        <div style="padding-bottom:80px;">
                            <p class="m-0">Firma y Sello</p>
                        </div>
                        <div style="padding-bottom:40px;">
                            <p class="m-0">Nombre y apellidos</p>
                        </div>
                        <p class="m-0">DNI:</p>
                    </div>
                    <div class="col-4">
                    <p class="m-0"><strong>Cliente</strong></p>
                        <div style="padding-bottom:80px;">
                            <p class="m-0">Firma y Sello</p>
                        </div>
                        <div style="padding-bottom:40px;">
                            <p class="m-0">Nombre y apellidos</p>
                        </div>
                        <p class="m-0">DNI:</p>
                    </div>
                    <div class="col-4">
                    <p class="m-0"><strong>Transportista</strong></p>
                        <div style="padding-bottom:80px;">
                            <p class="m-0">Firma y Sello</p>
                        </div>
                        <div style="padding-bottom:40px;">
                            <p class="m-0">Nombre y apellidos</p>
                        </div>
                        <p class="m-0">DNI:</p>
                    </div>
                </div>
                <div id="warning_text" class="row justify-content-end" style="margin-top:10px;">
                    <div class="col-4" style="border:2px solid black;">
                        <p style="margin: 5px;"><strong>Atención, está usted trabajando con géneros perecederos. Una vez firmada la nota, recuerde que la mercancía es suya, cuídela.</strong></p>
                    </div>
                </div>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <template id="report_purchaseorder">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="idealfruit_custom_purchase.report_purchaseorder_document" t-lang="o.partner_id.lang">
                    <t t-set="company" t-value="o.company_id"/>
                    <t t-set="user_to_sell" t-value="o.company_id"></t>
<!--                    <t t-set="user_to_sell" t-value="o.partner_id"></t>-->
                </t>
            </t>
        </t>
    </template>
    <report
        id="action_report_purchaseorder"
        model="purchase.order"
        string="Albarán de venta"
        report_type="qweb-pdf"
        name="idealfruit_custom_purchase.report_purchaseorder"
        file="idealfruit_custom_purchase.report_purchaseorder"
        print_report_name="'Albarán - %s' % (object.name)"
    />

</odoo>
