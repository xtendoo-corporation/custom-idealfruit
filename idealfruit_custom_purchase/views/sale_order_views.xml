<odoo>
    <record id="sale_order_form_inherit_add_page" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.add.page</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']" position="before">
                <page string="Lineas de compra" name="purchase_lines">
<!--                    <field name="purchase_line_ids">-->
<!--                    </field>-->
                    <field name="purchase_line_ids" mode="tree">
                        <tree string="Líneas de Compra">
                            <field name="product_id"/>
                            <field name="name"/>
                            <button name="action_abrir_productor_wizard_only_see"
                                    help="Productores"
                                    type="object"
                                    icon="fa-solid fa-user"
                                    class="oe_highlight"/>
                            <field name="product_variety_id"/>
                            <field name="box" string="Cajas Pedidas" sum="Total Cajas Pedidas"/>


                            <field name="unit_box" string="Und. Caja" sum="Total Und. Caja"/>
                            <field name="product_qty" sum="Total Cantidad"/>
                            <field name="price_unit" sum="Total Precio"/>
                            <field name="palet_type_id"/>
                            <field name="is_palet_base"/>
                            <field name="base_palet_line_id_number"/>
                            <field name="base_palet_line_id"/>
                            <field name="is_documented" invisible="1"/>
<!--                            <button name="action_abrir_indications_wizard_only_see"-->
<!--                                    type="object"-->
<!--                                    class="btn btn-outline-primary"-->
<!--                                    icon="fa-file-text-o"-->
<!--                                    attrs="{'invisible': [('is_documented', '=', True)]}"/>-->
                            <button name="action_abrir_indications_wizard_only_see"
                                    type="object"
                                    class="btn btn-outline-success"
                                    icon="fa-file-text-o"
                                    help="Indicaciones"
                                    attrs="{'invisible': [('is_documented', '=', False)]}"/>

                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
