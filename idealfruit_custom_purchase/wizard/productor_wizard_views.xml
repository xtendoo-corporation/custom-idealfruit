<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_productor_wizard_form" model="ir.ui.view">
        <field name="name">productor.wizard.form</field>
        <field name="model">productor.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Productor Lines">
                <group>
                    <field name="productor_line_ids">
                        <tree editable="bottom">
                            <field name="partner_id"/>
                            <field name="quantity" sum="Total"/>
                            <field name="referencia_palet"/>
                        </tree>
                    </field>
                </group>
                <footer>
                    <button string="Guardar" type="object" name="action_add_productor_lines" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_productor_wizard" model="ir.actions.act_window">
        <field name="name">Add Productor Lines</field>
        <field name="res_model">productor.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
