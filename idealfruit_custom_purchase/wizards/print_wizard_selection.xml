<odoo>
    <record id="view_select_sales_wizard_form" model="ir.ui.view">
        <field name="name">select.sales.wizard.form</field>
        <field name="model">select.sales.wizard</field>
        <field name="arch" type="xml">
            <form string="Seleccionar Órdenes de Venta">
                <group>
                    <field name="to_use_sale_order_ids" invisible="1" />
                    <field name="sale_order_ids" domain="[('id', 'in', to_use_sale_order_ids)]">
                        <tree>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="amount_total"/>
                            <field name="state"/>
                        </tree>
                    </field>
                </group>
                <group>
                    <field name="documento"></field>
                </group>
                <footer>
                    <button string="Confirmar" type="object" name="confirm_selection" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
